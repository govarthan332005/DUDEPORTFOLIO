rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() { return request.auth != null; }

    // Strong admin check: Firebase custom claims are preferred (token.admin == true).
    // Document-based membership is retained as a fallback so existing admin.html
    // keeps working. Self-escalation is impossible: writes to /admins are admin-only
    // and the FIRST admin is created manually in the Firebase Console (see SETUP.md).
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---------- Storefront catalog (public reads of ACTIVE docs only) ----------
    match /templates/{id} {
      allow get, list: if isAdmin() || resource.data.isActive == true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{id} {
      allow get, list: if isAdmin() || resource.data.isActive == true;
      allow create, update, delete: if isAdmin();
    }
    match /customForms/{id} {
      allow get, list: if isAdmin() || resource.data.enabled == true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- Reviews ----------
    match /reviews/{id} {
      // Public: approved only. Customers: their own reviews. Admins: everything.
      allow get, list: if isAdmin()
        || resource.data.status == 'approved'
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Customers create ONLY pending reviews with a strict shape — adminReply is
      // forced empty and status/moderation fields can never be set by customers.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.adminReply == ''
        && request.resource.data.templateId is string
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 80
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 1200
        && request.resource.data.keys().hasOnly(
             ['templateId','userId','userName','rating','comment','status','adminReply','createdAt']);
      allow update, delete: if isAdmin();
    }

    // ---------- User profiles ----------
    match /users/{uid} {
      allow get, list: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // Idempotent self-created profile: own doc only, safe fields only, no role fields.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','phone','photoURL','createdAt','lastLoginAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200;
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','email','phone','photoURL','lastLoginAt']));
      allow delete: if isAdmin();
    }

    // ---------- Orders ----------
    match /orders/{id} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      // Customers create ONLY a restricted draft: no price, currency, payment ids,
      // canonical payment fields, adminNotes, or workflow statuses can be set.
      // (userEmail / templateName are denormalised display fields — allowed so the
      // storefront & admin can render orders without extra reads.)
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.templateId is string
        && request.resource.data.keys().hasOnly(
             ['userId','userEmail','templateId','templateName','categoryId','formResponses','uploadedFiles','status','createdAt','updatedAt'])
        && !request.resource.data.keys().hasAny(
             ['amount','currency','paymentId','razorpayOrderId','razorpayPaymentId',
              'adminNotes','paidAt','paymentVerifiedAt','template','customer','expiresAt'])
        // The referenced template must exist and be purchasable.
        && exists(/databases/$(database)/documents/templates/$(request.resource.data.templateId))
        && get(/databases/$(database)/documents/templates/$(request.resource.data.templateId)).data.isActive == true;

      // Customers may only:
      //   (a) attach uploadedFiles while the order is a draft, or abandon their draft;
      //   (b) move a draft to payment_pending when they start a manual-UPI checkout;
      //   (c) submit manual-UPI payment proof (UTR + optional screenshot data URL).
      // Everything else (amounts, payment ids, admin notes, later workflow
      // statuses) is admin / Cloud-Function territory.
      allow update: if isAdmin() || (signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && (
          // (a) attach files / abandon while draft
          (resource.data.status == 'draft'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['uploadedFiles','status','updatedAt'])
            && (request.resource.data.status == 'draft'
                || request.resource.data.status == 'abandoned'))
          ||
          // (b) draft -> payment_pending (manual-UPI checkout started)
          (resource.data.status == 'draft'
            && request.resource.data.status == 'payment_pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['uploadedFiles','status','paymentMethod','updatedAt'])
            && request.resource.data.paymentMethod == 'manual_upi')
          ||
          // (c) submit UTR payment proof for manual UPI
          (resource.data.status in ['draft','payment_pending','failed']
            && request.resource.data.status == 'awaiting_verification'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status','utr','paymentMethod','paymentNote','upiVpaUsed',
                           'paymentScreenshotData','utrSubmittedAt','updatedAt'])
            && request.resource.data.utr is string
            && request.resource.data.utr.size() >= 8
            && request.resource.data.utr.size() <= 22
            && request.resource.data.paymentMethod == 'manual_upi'
            && (!request.resource.data.keys().hasAny(['paymentNote'])
                || (request.resource.data.paymentNote is string
                    && request.resource.data.paymentNote.size() <= 500))
            && (!request.resource.data.keys().hasAny(['upiVpaUsed'])
                || (request.resource.data.upiVpaUsed is string
                    && request.resource.data.upiVpaUsed.size() <= 120))
            && (!request.resource.data.keys().hasAny(['paymentScreenshotData'])
                || (request.resource.data.paymentScreenshotData is string
                    && request.resource.data.paymentScreenshotData.size() <= 1200000)))
        ));

      allow delete: if isAdmin();
    }

    // ---------- Contact messages (write-only for the public) ----------
    match /contactMessages/{id} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() <= 200
        && request.resource.data.whatsappRaw is string
        && request.resource.data.whatsappRaw.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'new'
        && request.resource.data.keys().hasOnly(
             ['name','email','whatsapp','whatsappRaw','message','status','userId','createdAt']);
      allow get, list, update, delete: if isAdmin();
    }

    // ---------- Site settings (public brand/contact/legal/payment-mode — no secrets here) ----------
    match /settings/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- Admin membership ----------
    match /admins/{uid} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------- Analytics rollups (written by scheduled Cloud Function only) ----------
    match /analyticsDaily/{id} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
